# Express 后端监听端口；仅允许 1—65535 的十进制整数。
PORT=3002

# 前端 API Base；默认使用 Vite 或部署反向代理提供的同源 /api。
VITE_API_BASE_URL=/api

# 内置管理员 admin 的初始化/恢复密码；复制为 .env 后在本机填写至少 8 位密码，不要提交真实密码。
CHARCOAL_ADMIN_PASSWORD=

# 允许访问 API 的额外精确 Origin，多个地址使用英文逗号分隔；不要配置通配符。
CORS_ALLOWED_ORIGINS=

# 是否允许公开注册；本地默认关闭。
CHARCOAL_ALLOW_REGISTER=false

# 登录会话有效小时数。
CHARCOAL_SESSION_TTL_HOURS=8

# 本机 cloudflared 官方 CLI 完整绝对路径；Windows 使用盘符或 UNC 路径，POSIX 使用 / 开头路径；留空时按系统 PATH 查找。
CLOUDFLARED_BIN=

# cloudflared Tunnel 传输协议；仅允许 auto、quic、http2，留空等同 auto；UDP/QUIC 不稳定时可仅在本机 .env 改为 http2。
TUNNEL_TRANSPORT_PROTOCOL=auto

# 本地数据目录；留空使用项目根 data/。
DATA_DIR=

# SQLite 文件路径；留空使用 DATA_DIR 下的 energy-carbon.sqlite。
SQLITE_PATH=

# 上传文件目录；留空使用 DATA_DIR 下的 uploads/。
UPLOADS_DIR=

# 备份文件目录；留空使用 DATA_DIR 下的 backups/。
BACKUPS_DIR=
